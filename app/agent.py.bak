def call_llm(messages, tools=None):
    payload = {
        "model": MODEL,
        "messages": messages,
        "stream": False
    }

    if tools:
        payload["tools"] = tools

    response = requests.post(
        OLLAMA_URL,
        json=payload,
        timeout=120
    )

    response.raise_for_status()

    data = response.json()

    print("\n========== RAW OLLAMA RESPONSE ==========")
    print(json.dumps(data, ensure_ascii=False, indent=2))
    print("==========================================\n")

    return data

def run_agent(user_input, event_callback=None):

    def emit(event_type, message):
        logger.info(message)

        if event_callback:
            event_callback({
                "type": event_type,
                "message": message
            })

    emit("user", f"用户请求：{user_input}")

    messages = [
        {
            "role": "system",
            "content": (
                "你是一个 AI 编程 Agent。"
                "如果用户的问题需要数学计算，可以使用 calculator 工具。"
                "如果用户询问当前日期或时间，请使用 get_current_time 工具。"
                "如果用户需要运行 Python 代码、进行数据处理或 Debug，请使用 run_python 工具。"
                "如果用户要求分析项目结构，请使用 list_project_files 工具。"
                "如果用户要求阅读、分析或查找项目中的代码，请使用 read_project_file 工具。"
                "如果用户明确要求创建、修改、修复或覆盖项目文件，必须使用 write_project_file 工具。"
                "修改项目文件时，不要使用 run_python 代替 write_project_file。"
                "如果需要先了解文件内容，可以先使用 read_project_file，然后使用 write_project_file 修改。"
                "write_project_file 返回成功后，必须根据工具返回结果判断文件是否修改成功。"
                "不要假装读取了没有通过工具返回的文件内容，必须根据工具实际返回的内容进行分析。"
                "如果 Python 执行失败，你必须分析错误信息。"
                "如果 Python 执行成功，也不能仅因为程序没有报错就认为代码正确。"
                "验证代码时，必须同时检查实际输出是否符合用户要求、代码语义以及函数或变量名称表达的预期。"
                "如果代码能够运行但实际结果与合理预期不一致，也必须将其视为代码问题。"
                "如果发现逻辑错误，必须修改导致错误的实现，而不能仅通过修改函数名、变量名或描述来掩盖原来的错误。"
                "修改代码后必须再次调用 run_python，验证修复后的实际结果。"
                "如果第二次验证结果仍然不符合预期，继续分析并修复。"
                "最多允许连续 Debug 3 次。"
                "如果用户要求运行或验证 Python 代码的计算结果，"
                "必须让 Python 代码通过 print() 输出需要验证的结果。"
                "不能仅根据代码逻辑猜测执行结果。"
                "达到 Debug 上限后，禁止再次调用 run_python。"
                "达到上限后必须直接总结失败原因，并告诉用户无法继续执行。"
                "不要自己猜测 Python 的执行结果。"
            )
        },
        {
            "role": "user",
            "content": user_input
        }
    ]

    debug_count = 0
    max_debug_count = 3

    while True:

        emit("thinking", "Agent 正在分析任务")

        # 如果已经达到 Debug 上限，
        # 不再给模型任何 Tool，强制模型生成最终总结。
        if debug_count >= max_debug_count:

            emit(
                "limit",
                f"Debug 已达到上限 {max_debug_count} 次，停止工具调用"
            )

            messages.append({
                "role": "user",
                "content": (
                    f"Python Debug 已经连续失败 {max_debug_count} 次。"
                    "现在禁止继续调用任何 Python 工具。"
                    "请直接分析最近一次错误原因，"
                    "总结为什么没有成功，并向用户给出明确说明。"
                )
            })

            data = call_llm(messages, tools=None)
            final_message = data["message"]
            final_content = final_message.get("content", "")

            emit("answer", "Agent 已停止 Debug 并生成最终总结")

            return final_content

            data = call_llm(messages, tools=TOOLS)

        message = data["message"]

        emit("thinking", "Agent 收到模型响应")

        if "tool_calls" in message:

            tool_calls = message["tool_calls"]

        else:

            content = message.get("content", "")

            if "<tool_call>" not in content:

                if not content.strip():

                    emit(
                        "success",
